{
  "manifest_version": 3,
  "name": "Otzi a Rindegastos",
  "description": "Carga exportaciones CSV de Expenses y rellena gastos multiples en Rindegastos.",
  "version": "0.4.7",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "debugger",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
